# Written to /etc/caddy/Caddyfile by scripts/setup-control-plane.sh.
# The agent keeps its service routes (@id tw-*) in the HTTP server named
# "trailway" through the admin API. Naming the Caddyfile server the same means
# the control plane site and the agent routes share one server, so a Caddy
# restart keeps the control plane and the agent's 30 s re-sync adds back its
# routes without ever replacing the config.
{
	admin 127.0.0.1:2019
	servers :443 {
		name trailway
	}
}

__DOMAIN__ {
	@api path /api/* /install.sh /downloads/*
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
